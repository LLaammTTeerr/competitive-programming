# Copy to .env and fill in. These are read from the MCP servers' environment;
# neither server loads .env files itself, so either export them or paste them
# into the MCP client config's "env" block (see README).
#
# The CODEFORCES_*/CF_* names belong to the `cf-mcp` server, the POLYGON_* ones
# to `polygon-mcp`. Neither reads the other's variables.

# =========================== cf-mcp (Codeforces) ===========================

# --- Authentication -------------------------------------------------------
# Codeforces guards its login page with a Cloudflare browser challenge, so a
# handle+password cannot be used to sign in from a script. Instead, sign in at
# codeforces.com in your browser, then copy the JSESSIONID cookie:
#   DevTools -> Application/Storage -> Cookies -> https://codeforces.com
CODEFORCES_COOKIE=JSESSIONID=

# Your handle. Not needed to authenticate, but used for user.status lookups.
CODEFORCES_HANDLE=

# Optional and normally blocked by Cloudflare; kept as a best-effort fallback.
CODEFORCES_PASSWORD=

# --- Optional -------------------------------------------------------------
# Only needed for authorized API reads, e.g. a running contest's submissions.
# Create at https://codeforces.com/settings/api
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=

CF_MCP_DEFAULT_LANGUAGE=GNU G++23
# CF_MCP_STATE_DIR=~/.cache/cf-mcp
# CF_MCP_TIMEOUT=30

# ============================ polygon-mcp (Polygon) ========================

# --- Authentication -------------------------------------------------------
# Polygon has a real API, so no cookie games: generate a key pair at
# https://polygon.codeforces.com -> Settings -> API keys. Both halves are
# required; the secret is used to sign requests and is never sent.
POLYGON_API_KEY=
POLYGON_API_SECRET=

# --- The path guard -------------------------------------------------------
# The one directory the server may read a file from when a tool is called with
# `path=` instead of inline content. Leave it unset and every path is refused,
# which is the safe default: content then has to be passed inline.
POLYGON_MCP_ROOT=

# --- Optional -------------------------------------------------------------
# POLYGON_BASE_URL=https://polygon.codeforces.com/api/
# POLYGON_TIMEOUT=30
# POLYGON_MIN_INTERVAL=0.5
